# Internal service URLs used by the Next.js server-side proxy
# (frontend/src/pages/api/backend/[...path].ts and the rewrite in next.config.js).
# These are read by the frontend CONTAINER, not the browser — the browser only
# ever calls same-origin /api/backend/* and /api/beespector/*.
# docker-compose.yml already sets both; override here only for non-compose setups.
BACKEND_INTERNAL_URL=http://backend:8000
BEESPECTOR_INTERNAL_URL=http://beespector:8001

# Redis connection for the backend. docker-compose.yml sets REDIS_HOST=redis.
# Outside Docker the backend defaults to 127.0.0.1:6379.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
